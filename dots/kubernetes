alias konfig="kubectl konfig"
alias kube-import="kubectl konfig import"

# -- FUNCTIONS --

# TODO: kubectl plugin ?
function k8s-show-image() {
	kubectl get pods --all-namespaces -l app="${1}" -ojsonpath="{.items[*].spec.containers[?(@.name==\"$1\")].image}"
}
